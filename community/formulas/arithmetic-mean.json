{
  "schema": 1,
  "kind": "dars-formula",
  "id": "arithmetic-mean",
  "version": "1.0.0",
  "name": "Arithmetic mean of two values",
  "description": "Unweighted arithmetic mean of two dimensionless quantities.",
  "category": "statistics",
  "expression": "(a + b) / 2",
  "domain": "Finite rational observations.",
  "unit": "1",
  "parameters": [
    {
      "name": "a",
      "type": "rational",
      "unit": "1",
      "default": "1/3"
    },
    {
      "name": "b",
      "type": "rational",
      "unit": "1",
      "default": "2/3"
    }
  ],
  "dependencies": [],
  "references": [
    "Arithmetic mean of a finite list, sum divided by count."
  ],
  "author": "DARS contributors",
  "license": "Apache-2.0",
  "tests": [
    {
      "name": "Rational mean",
      "inputs": {},
      "expected": "1/2",
      "unit": "1"
    },
    {
      "name": "Large adjacent observations",
      "inputs": {
        "a": {
          "value": "9007199254740993",
          "unit": "1"
        },
        "b": {
          "value": "9007199254740995",
          "unit": "1"
        }
      },
      "expected": "9007199254740994",
      "unit": "1"
    }
  ]
}
