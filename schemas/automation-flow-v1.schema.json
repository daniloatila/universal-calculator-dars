{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DARS Automation Studio flow v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "dars-flow"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "maxProperties": 32,
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "steps": {
      "allOf": [
        {
          "$ref": "#/$defs/steps"
        },
        {
          "minItems": 1
        }
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "inputs",
    "steps",
    "outputs"
  ],
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "string"
          ]
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
